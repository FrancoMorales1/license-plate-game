# JID del grupo de WhatsApp a escuchar (formato: 123456789012345678@g.us)
WHATSAPP_GROUP_JID=

# Carpeta donde Baileys persiste la sesión (montada como volumen en Docker)
WHATSAPP_AUTH_DIR=./auth

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Google Service Account (solo para Sheets: compartir el Sheet con su email)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_SHEET_ID=

# Google Drive: las service accounts no tienen cuota de almacenamiento propia, así que las
# fotos se suben vía OAuth con tu cuenta personal (la dueña de la carpeta). Generar con:
# pnpm get-drive-token (requiere GOOGLE_OAUTH_CLIENT_ID/SECRET ya completos acá)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# debug | info | warn | error
LOG_LEVEL=info
