# JID del grupo de WhatsApp a escuchar (formato: 123456789012345678@g.us)
WHATSAPP_GROUP_JID=

# Carpeta donde Baileys persiste la sesión (montada como volumen en Docker)
WHATSAPP_AUTH_DIR=./auth

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Google Service Account
# Ruta al JSON de la cuenta de servicio (compartir el Sheet y la carpeta de Drive con su email)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Horas hasta el cierre automático de cada encuesta de puntaje
POLL_CLOSE_HOURS=24

# debug | info | warn | error
LOG_LEVEL=info
