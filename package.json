{
  "name": "patentes-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "get-group-jid": "tsx src/scripts/getGroupJid.ts",
    "get-drive-token": "tsx src/scripts/getDriveToken.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && tsup src/index.ts --format esm --target node20 --clean --sourcemap",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm format && pnpm test && pnpm build"
  },
  "dependencies": {
    "@google-cloud/vision": "^6.0.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bullmq": "^6.2.0",
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
